def archive_deps(path):
    """The link inputs recorded in an archive's gexcc.deps.o member."""
    try:
        data = open(path, 'rb').read()
    except OSError:
        return []
    if not data.startswith(AR_MAGIC):
        return []
    a = data.find(b'GEXCC-DEPS\n')
    if a < 0:
        return []
    b = data.find(b'\nGEXCC-END', a)
    if b < 0:
        return []
    # (as the writer records them: `=` the sysroot, a relative path the
    # archive's own directory; one moved with its package since, an
    # archive found by name)
    base, out = os.path.dirname(os.path.abspath(path)), []
    for d in data[a + 11:b].decode().split('\n'):
        flag = '-L' if d.startswith('-L') else ''
        v = d[len(flag):]
        if v.startswith('='):
            v = SYSROOT + v[1:]
        elif v and not v.startswith(('/', '-')):
            v = os.path.normpath(os.path.join(base, v))
            m = re.match(r'lib(.+)\.(a|so)$', os.path.basename(v))
            if not flag and not os.path.exists(v) and m:
                v = '-l' + m.group(1)
        out.append(flag + v)
    return out


def ld_script_inputs(path):
    """A GNU ld script in a library's place (libbsd.so: GROUP(libbsd.so.0
    AS_NEEDED(-lmd))): the inputs it names, a target path the build machine
    lacks being the sysroot's. None for anything else."""
    try:
        with open(path, 'rb') as f:
            head = f.read(4096)
    except OSError:
        return None
    if b'\0' in head or not re.search(rb'\b(GROUP|INPUT)\s*\(', head):
        return None
    text = re.sub(r'/\*.*?\*/', ' ', open(path, errors='replace').read(), flags=re.S)
    out = []
    for m in re.finditer(r'\b(?:GROUP|INPUT)\s*\(((?:[^()]|\([^()]*\))*)\)', text):
        for tok in re.split(r'[\s,()]+', m.group(1)):
            if not tok or tok == 'AS_NEEDED':
                continue
            if tok.startswith('-l'):
                out.append(tok)
            elif tok.startswith('/'):
                out.append(in_sysroot(tok))
            else:
                out.append(os.path.join(os.path.dirname(path), tok))
    return out


def expand(items, seen):
    """Link inputs with -l resolved and archives' recorded deps appended."""
    res, missing = [], []
    for it in items:
        if not it:
            continue
        if it in WHOLE:
            res.append(it)
            continue
        if it.startswith('-l'):
            nm = it[2:]
            # libc and its parts are linked last, after libgex, whose
            # definitions (dlopen, dlsym) must win over musl's weak stubs:
            # an -lc mid-line would pull those first
            p = resolve(nm)
            # (unless the name is a library of its own outside libc's
            # directory: libxcrypt's libcrypt, with crypt_gensalt, which
            # musl's crypt does not have, beside musl's empty libcrypt.a)
            if nm in LIBC_NAMES and (p is None or os.path.dirname(p) == os.path.abspath(LIB)
                                     or os.path.getsize(p) <= len(AR_MAGIC)):
                continue
            if p is None:
                if CXX and nm in ('stdc++', 'c++', 'c++abi', 'supc++'):
                    continue
                missing.append(it)
                continue
            it = p
        elif not it.startswith('-'):
            it = os.path.abspath(it)
        if it in seen:
            continue
        seen.add(it)
        script = ld_script_inputs(it) if not it.startswith('-') else None
        if script is not None:
            sub, miss = expand(script, seen)
            res += sub
            missing += miss
            continue
        if it.endswith('.rlib'):
            res += rlib_ctors(it)
        res.append(it)
        if is_archive(it):
            sub, miss = expand(archive_deps(it), seen)
            res += sub
            missing += miss
    return res, missing


def _ar_members(data):
    """An ar archive's members, (name, bytes): GNU names (the // table) and
    BSD ones (#1/LEN)."""
    pos, longnames = 8, b''
    while pos + 60 <= len(data):
        h = data[pos:pos + 60]
        name, size = h[:16].rstrip(b' '), int(h[48:58].strip() or 0)
        body = data[pos + 60:pos + 60 + size]
        pos += 60 + size + (size & 1)
        if name == b'//':
            longnames = body
            continue
        if name in (b'/', b'/SYM64/', b'__.SYMDEF', b'__.SYMDEF SORTED'):
            continue
        if name.startswith(b'#1/'):
            n = int(name[3:])
            name, body = body[:n].rstrip(b'\0'), body[n:]
        elif name.startswith(b'/') and name[1:].isdigit():
            off = int(name[1:])
            name = longnames[off:longnames.index(b'/\n', off)]
        else:
            name = name.rstrip(b'/')
        yield name.decode(errors='replace'), body


def _has_init_funcs(obj):
    """Whether a wasm object lists constructors (its linking section's
    WASM_INIT_FUNCS)."""
    if not obj.startswith(b'\0asm'):
        return False
    def uleb(i):
        r = sh = 0
        while True:
            b = obj[i]; i += 1
            r |= (b & 0x7f) << sh; sh += 7
            if b < 0x80:
                return r, i
    i = 8
    while i < len(obj):
        sid = obj[i]
        n, i = uleb(i + 1)
        end = i + n
        if sid == 0:
            ln, j = uleb(i)
            if obj[j:j + ln] == b'linking':
                j += ln
                _, j = uleb(j)  # version
                while j < end:
                    kind = obj[j]
                    sz, j = uleb(j + 1)
                    if kind == 6:
                        return uleb(j)[0] > 0
                    j += sz
                return False
        i = end
    return False


def rlib_ctors(path):
    """A Rust rlib's members that have constructors, as objects to link
    whole. rustc's ELF links pull every #[used] static (an inventory or
    ctor crate's .init_array entry) through a symbols.o of references, which
    it does not write for wasm: without this a crate's registration that
    nothing else in its object refers to is not linked. C and C++ archives
    keep the archive rule."""
    try:
        data = open(path, 'rb').read()
    except OSError:
        return []
    if not data.startswith(AR_MAGIC):
        return []
    out = []
    for k, (name, body) in enumerate(_ar_members(data)):
        if name.endswith('.o') and _has_init_funcs(body):
            o = os.path.join(tmp, 'rlib-%d-%s-%s' % (len(os.listdir(tmp)), k, os.path.basename(name)))
            open(o, 'wb').write(body)
            out.append(o)
    return out


def imports(path):
    """(module, name) of every function import of the module at path."""
    w = open(path, 'rb').read()

    def leb(p):
        r = sh = 0
        while True:
            x = w[p]; p += 1
            r |= (x & 0x7f) << sh; sh += 7
            if not x & 0x80:
                return r, p

    def nm(p):
        n, p = leb(p)
        return w[p:p + n].decode(), p + n
    res, p = [], 8
    while p < len(w):
        sid = w[p]; n, q = leb(p + 1); end = q + n
        if sid == 2:
            cnt, q = leb(q)
            for _ in range(cnt):
                m, q = nm(q); f, q = nm(q)
                kind = w[q]; q += 1
                if kind == 0:
                    _, q = leb(q); res.append((m, f))
                elif kind == 1:
                    q += 1; fl, q = leb(q); _, q = leb(q)
                    if fl & 1: _, q = leb(q)
                elif kind == 2:
                    fl, q = leb(q); _, q = leb(q)
                    if fl & 1: _, q = leb(q)
                elif kind == 3:
                    q += 2
                elif kind == 4:
                    q += 1; _, q = leb(q)
            break
        p = end
    return res



def widest_table_params(path):
    """The most parameters of any function a table holds (the element
    segments, active or passive): what binaryen's --fpcast-emu needs as
    max-func-params, since each such function gets a thunk that width."""
    w = open(path, 'rb').read()

    def leb(p):
        r = sh = 0
        while True:
            x = w[p]; p += 1
            r |= (x & 0x7f) << sh; sh += 7
            if not x & 0x80:
                return r, p

    def expr(p):
        # a constant expression: the function a ref.func names, if any
        f = None
        while w[p] != 0x0b:
            op = w[p]; p += 1
            if op == 0xd2:
                f, p = leb(p)
            elif op in (0x41, 0x42, 0x23):
                _, p = leb(p)
            elif op == 0xd0:
                p += 1
        return f, p + 1
    params, ftypes, elems, p = [], [], [], 8
    while p < len(w):
        sid = w[p]; n, q = leb(p + 1); end = q + n
        if sid == 1:
            cnt, q = leb(q)
            for _ in range(cnt):
                q += 1  # 0x60
                np, q = leb(q); q += np  # value types are one byte (no GC types here)
                nr, q = leb(q); q += nr
                params.append(np)
        elif sid == 2:
            cnt, q = leb(q)
            for _ in range(cnt):
                ln, q = leb(q); q += ln; ln, q = leb(q); q += ln
                kind = w[q]; q += 1
                if kind == 0:
                    t, q = leb(q); ftypes.append(t)
                elif kind in (1, 2):
                    if kind == 1:
                        q += 1
                    fl, q = leb(q); _, q = leb(q)
                    if fl & 1: _, q = leb(q)
                elif kind == 3:
                    q += 2
                elif kind == 4:
                    q += 1; _, q = leb(q)
        elif sid == 3:
            cnt, q = leb(q)
            for _ in range(cnt):
                t, q = leb(q); ftypes.append(t)
        elif sid == 9:
            cnt, q = leb(q)
            for _ in range(cnt):
                fl, q = leb(q)
                if fl & 2 and not fl & 1:
                    _, q = leb(q)  # table index
                if not fl & 1:
                    _, q = expr(q)  # offset
                if fl & 3:
                    q += 1  # element kind or reference type
                k, q = leb(q)
                for _ in range(k):
                    if fl & 4:
                        f, q = expr(q)
                    else:
                        f, q = leb(q)
                    if f is not None:
                        elems.append(f)
        p = end
    return max([params[ftypes[f]] for f in elems if f < len(ftypes)] or [0])

