def is_wasm_so(p):
    """A side module: wasm whose first section is dylink.0. An object file
    (its first section is code's, its custom ones `linking` and relocs)
    is not one, though it is wasm too."""
    try:
        with open(p, 'rb') as f:
            head = f.read(8 + 1 + 5 + 1 + 8)
    except OSError:
        return False
    if head[:4] != b'\0asm' or len(head) < 10 or head[8] != 0:
        return False
    q = 9
    while q < len(head) and head[q] & 0x80:  # the section's size
        q += 1
    q += 1
    return head[q:q + 9] == b'\x08dylink.0'


def sections(path):
    """(name, payload) of every custom section, and the export names."""
    w = open(path, 'rb').read()

    def leb(p):
        r = sh = 0
        while True:
            x = w[p]; p += 1
            r |= (x & 0x7f) << sh; sh += 7
            if not x & 0x80:
                return r, p
    customs, exports, p = [], [], 8
    while p < len(w):
        sid = w[p]; n, q = leb(p + 1); end = q + n
        if sid == 0:
            ln, q2 = leb(q)
            customs.append((w[q2:q2 + ln].decode('utf-8', 'replace'), w[q2 + ln:end]))
        elif sid == 7:
            cnt, q = leb(q)
            for _ in range(cnt):
                ln, q = leb(q); exports.append(w[q:q + ln].decode()); q += ln
                q += 1; _, q = leb(q)
        p = end
    return customs, exports


def _uleb(n):
    out = bytearray()
    while True:
        b = n & 0x7f; n >>= 7
        out.append(b | (0x80 if n else 0))
        if not n:
            return bytes(out)


def rename_data(src, dst, old, new):
    """A copy of the wasm object SRC as DST with its data symbol OLD
    (defined or not) named NEW, in the `linking` section's symbol table;
    relocations name symbols by index, so nothing else changes. False when
    SRC has no such symbol (and DST is not written)."""
    w = open(src, 'rb').read()
    if w[:4] != b'\0asm':
        return False

    def leb(b, p):
        r = sh = 0
        while True:
            x = b[p]; p += 1
            r |= (x & 0x7f) << sh; sh += 7
            if not x & 0x80:
                return r, p

    def name(b, p):
        n, p = leb(b, p)
        return b[p:p + n], p + n
    out, p, hit = bytearray(w[:8]), 8, False
    while p < len(w):
        sid = w[p]; n, q = leb(w, p + 1); end = q + n
        body = w[q:end]
        nm, r = name(body, 0) if sid == 0 else (b'', 0)
        if sid == 0 and nm == b'linking':
            ver, r = leb(body, r)
            nb = bytearray(body[:r])
            while r < len(body):
                kind = body[r]; ln, r2 = leb(body, r + 1); sub = body[r2:r2 + ln]
                if kind == 8:  # WASM_SYMBOL_TABLE
                    cnt, t = leb(sub, 0)
                    ns = bytearray(_uleb(cnt))
                    for _ in range(cnt):
                        start = t
                        k = sub[t]; flags, t = leb(sub, t + 1)
                        head = sub[start:t]
                        if k == 1:  # data: name, then where if defined
                            sym, t = name(sub, t)
                            rest_start = t
                            if not flags & 0x10:
                                for _ in range(3):
                                    _, t = leb(sub, t)
                            if sym == old.encode():
                                sym, hit = new.encode(), True
                            ns += head + _uleb(len(sym)) + sym + sub[rest_start:t]
                        elif k == 3:  # section
                            _, t = leb(sub, t)
                            ns += sub[start:t]
                        else:  # function, global, tag, table: index, name if any
                            _, t = leb(sub, t)
                            if not flags & 0x10 or flags & 0x40:
                                _, t = name(sub, t)
                            ns += sub[start:t]
                    sub = bytes(ns)
                nb += bytes([kind]) + _uleb(len(sub)) + sub
                r = r2 + ln
            body = bytes(nb)
        out += bytes([sid]) + _uleb(len(body)) + body
        p = end
    if hit:
        open(dst, 'wb').write(out)
    return hit


def soname_of(path):
    """A side module's soname: its name section's module name."""
    for name, data in sections(path)[0]:
        if name == 'name' and data[:1] == b'\0':
            p = 1
            n = 0; sh = 0
            while True:
                x = data[p]; p += 1; n |= (x & 0x7f) << sh; sh += 7
                if not x & 0x80:
                    break
            q = p; ln = 0; sh = 0
            while True:
                x = data[q]; q += 1; ln |= (x & 0x7f) << sh; sh += 7
                if not x & 0x80:
                    break
            return data[q:q + ln].decode()
    return os.path.basename(path)


def whole_closed(ins):
    """The inputs with a --whole-archive left open closed after them, so
    the libraries gexcc adds are not taken whole."""
    marks = [x for x in ins if x in WHOLE]
    return ins + ['--no-whole-archive'] if marks and marks[-1] == '--whole-archive' else ins


def by_soname(paths):
    """Each side module as a link of its soname: wasm-ld records a NEEDED
    library by the name it was given, and the loader looks for sonames."""
    d = os.path.join(tmp, 'sonames')
    os.makedirs(d, exist_ok=True)
    out = []
    for p in paths:
        if is_wasm_so(p) and not is_archive(p):
            q = os.path.join(d, soname_of(p))
            if not os.path.exists(q):
                os.symlink(os.path.abspath(p), q)
            out.append(q)
        else:
            out.append(p)
    return out


def finish_shared(wasm, sos, lib):
    """A shared-mode module after wasm-ld: a library's imports of its own
    functions bound (gex-dylink selfbind), asyncify for fork where it can
    be reached (from the libraries' gex.forkreach summaries, every indirect
    call counting), exception handling to exnref, and a library's own
    summary added."""
    if lib and run([DYLINK, 'selfbind', wasm, wasm]):
        die('gex-dylink selfbind failed')
    # GEXCC_LENIENT_CALLS=1: indirect calls with more trailing arguments than
    # the function takes cut as C makes them (gex-dylink lenient-calls), for
    # GLib, whose callers pass GObject's initialisers and a GFunc more than
    # they take; before asyncify, which then instruments the helpers
    lenient = os.environ.get('GEXCC_LENIENT_CALLS', '0') != '0'
    if lenient and run([DYLINK, 'lenient-calls', wasm, wasm]):
        die('gex-dylink lenient-calls failed')
    if NOFORK:
        no_fork_point(wasm)
        if run([opt, wasm, '-g', '--strip-dwarf'] + feats + (['--enable-gc'] if lenient else [])
               + ['--translate-to-exnref', '-o', wasm]):
            die('wasm-opt failed')
        split_relocs(wasm)
        if lib:
            # its summary: nothing in it reaches fork
            txt = os.path.join(tmp, 'forkreach.txt')
            open(txt, 'w').write('gex.forkreach 1\n')
            if run([DYLINK, 'section', wasm, 'gex.forkreach', txt, wasm]):
                die('gex-dylink section failed')
        return
    may, known = set(), set()
    for so in sos:
        if not is_wasm_so(so):
            continue
        cs, ex = sections(so)
        known |= set(ex)
        for name, data in cs:
            if name == 'gex.forkreach':
                may |= set(data.decode().split('\n')[1:]) - {''}
    also = sorted('env.' + f for m, f in imports(wasm) if m == 'env' and (f in may or f not in known)
                  and f not in ('__indirect_function_table',))
    lst = os.path.join(tmp, 'onlylist')
    summ = os.path.join(tmp, 'forkreach')
    dis = os.path.join(os.path.dirname(opt), 'wasm-dis')
    reach = subprocess.run([sys.executable, os.path.join(LIBDIR, 'forkreach.py'), '--also', ','.join(also), '--indirect',
                            '--ignore', '__gex_call_handler,__pthread_exit', '--exports', summ, dis, wasm, 'gex.fork_point']
                           + FORK_ROOTS, capture_output=True, text=True)
    passes = []
    if reach.returncode == 0:
        only = [f for f in reach.stdout.strip().split(',') if f]
        if only:
            open(lst, 'w').write('\n'.join(only) + '\n')
            passes += ['--asyncify', '--pass-arg=asyncify-relocatable',
                       '--pass-arg=asyncify-imports@' + ','.join(['gex.fork_point'] + also),
                       '--pass-arg=asyncify-onlylist@@' + lst, '-O2']
    else:
        # not analysable: everything that may reach an import or an indirect call
        open(summ, 'w').write('\n'.join(sections(wasm)[1]) + '\n')
        defined = set(sections(wasm)[1])
        passes += ['--asyncify', '--pass-arg=asyncify-relocatable']
        roots = [f for f in FORK_ROOTS if f in defined]
        if roots:
            passes += ['--pass-arg=asyncify-removelist@' + ','.join(roots)]
        passes += ['-O2']
    passes += ['--translate-to-exnref']
    if run([opt, wasm, '-g', '--strip-dwarf'] + feats + (['--enable-gc'] if lenient else []) + passes + ['-o', wasm]):
        die('wasm-opt failed')
    split_relocs(wasm)
    if lib:
        txt = os.path.join(tmp, 'forkreach.txt')
        names = open(summ).read().split() if os.path.exists(summ) else []
        open(txt, 'w').write('gex.forkreach 1\n' + ''.join(n + '\n' for n in names))
        if run([DYLINK, 'section', wasm, 'gex.forkreach', txt, wasm]):
            die('gex-dylink section failed')


def split_relocs(wasm):
    """wasm-ld's data relocation function in pieces when it is too large
    for an engine to compile (gex-dylink split-relocs); after wasm-opt,
    whose inliner would join them again."""
    if run([DYLINK, 'split-relocs', wasm, wasm]):
        die('gex-dylink split-relocs failed')


def no_fork_point(wasm):
    """A -fgex-no-fork link must not reach fork's driver: one that does
    would unwind through frames asyncify left alone."""
    if ('gex', 'fork_point') in imports(wasm):
        die('-fgex-no-fork: %s still reaches fork (it imports gex.fork_point)' % os.path.basename(out))


WASM_C = {'i32': 'int', 'i64': 'long long', 'f32': 'float', 'f64': 'double'}


def link_shared(cmd):
    """wasm-ld for a shared-mode link. A function an object declares with
    one type and a side module defines with another stops wasm-ld, where an
    ELF link (which knows no types) goes through: configure's link tests
    declare `char f(void)` for every function they look for. As wasm-ld
    does for a static library's function of the wrong type, the link gets
    a stub of the object's type that traps when called, with a warning.
    Unless the two differ only in the object's declaring no result
    (gettext's `extern void tputs (...)` for ncurses' int one): then the
    stub calls the library's and drops what it returns, as the ELF call
    does."""
    stubs = []
    for _ in range(64):
        # (first: a definition the side module's then meets defined)
        if VERBOSE:
            sys.stderr.write('+ %s\n' % ' '.join(cmd[:1] + stubs + cmd[1:]))
        p = subprocess.run(cmd[:1] + stubs + cmd[1:], capture_output=True, text=True)
        if p.returncode == 0:
            sys.stderr.write(p.stderr)
            return 0
        # wasm-ld crashes writing debug sections whose relocations name a
        # function the link imports from a side module (harfbuzz's tests:
        # DWARF locations in hb_set_reference, defined in libharfbuzz.so):
        # the link again without debug information
        if 'CustomSection::writeTo' in p.stderr and '--strip-debug' not in cmd:
            sys.stderr.write('gexcc: warning: wasm-ld failed on the debug sections; %s is linked without them\n'
                             % os.path.basename(out))
            cmd = cmd + ['--strip-debug']
            continue
        found = re.findall(r'function signature mismatch: (\S+)\n>>> defined as \(([^)]*)\) -> (\S+) in (\S+)\n'
                           r'>>> defined as \(([^)]*)\) -> (\S+) in (\S+)', p.stderr)
        found = [f for f in found if '/sonames/' in f[6] or is_wasm_so(f[6])]
        # A program's own variable named as a library's function (hunspell's
        # `int warn`, libc's warn()): on ELF the program's definition is the
        # one its own code reaches, and so it is here, under a name of its
        # own in the program's objects
        clash = [m[0] for m in re.findall(
            r'symbol type mismatch: (\S+)\n>>> defined as WASM_SYMBOL_TYPE_(DATA|FUNCTION) in (\S+)\n'
            r'>>> defined as WASM_SYMBOL_TYPE_(DATA|FUNCTION) in (\S+)', p.stderr)
            if {m[1], m[3]} == {'DATA', 'FUNCTION'}
            and is_wasm_so(m[2] if m[1] == 'FUNCTION' else m[4])]
        renamed = False
        for name in clash:
            for i, a in enumerate(cmd):
                if a.startswith('-') or not os.path.isfile(a) or is_wasm_so(a) or is_archive(a):
                    continue
                o = os.path.join(tmp, 'own-%d-%s' % (i, os.path.basename(a)))
                if rename_data(a, o, name, '__gexcc_own.' + name):
                    cmd = cmd[:i] + [o] + cmd[i + 1:]
                    renamed = True
        if renamed:
            continue
        if not found:
            sys.stderr.write(p.stderr)
            return p.returncode
        for name, params, ret, _, lparams, lret, so in found:
            c = os.path.join(tmp, 'mismatch-%d.c' % len(stubs))
            types = [WASM_C[t.strip()] for t in params.split(',') if t.strip()]
            args = ', '.join('%s a%d' % (t, i) for i, t in enumerate(types))
            drop = ret == 'void' and lret != 'void' and params == lparams
            if drop:
                # the library's, imported under its own name; the stub is
                # the object's alone (hidden), not another definition
                open(c, 'w').write('__attribute__((import_name("%s"))) %s __gexcc_lib_%s(%s);\n'
                                   '__attribute__((visibility("hidden"))) void %s(%s) { __gexcc_lib_%s(%s); }\n'
                                   % (name, WASM_C[lret], name, ', '.join(types) or 'void', name, args or 'void',
                                      name, ', '.join('a%d' % i for i in range(len(types)))))
            else:
                # (says so on stderr when reached: a call that gets here is
                # a miscompile the build let through)
                msg = 'gexcc: %s called through a declaration of the wrong type (stub)\n' % name
                open(c, 'w').write('long write(int, const void *, unsigned long);\n'
                                   '%s %s(%s) { write(2, "%s", %d); __builtin_trap(); }\n'
                                   % (WASM_C.get(ret, 'void'), name, args or 'void', msg.replace('\n', '\\n'), len(msg)))
            o = c[:-2] + '.o'
            if subprocess.call(['clang', '--target=' + TRIPLE, '-fPIC', '-c', '-w', '-fno-builtin', '-o', o, c]
                               + [a for a in BASE if a.startswith('-m') and a != '-mllvm']):
                sys.stderr.write(p.stderr)
                return p.returncode
            if drop:
                sys.stderr.write('gexcc: note: %s is declared (%s) -> void but %s returns %s: its result is dropped\n'
                                 % (name, params, os.path.basename(so), lret))
            else:
                sys.stderr.write('gexcc: warning: %s is declared (%s) -> %s but %s defines another type: '
                                 'calls to it trap\n' % (name, params, ret, os.path.basename(so)))
            stubs.append(o)
    return 1


