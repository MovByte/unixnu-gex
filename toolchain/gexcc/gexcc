#!/usr/bin/env python3
"""gexcc / gexc++: a C/C++ compiler for gex's wasm32 Linux target.

Used like gcc or clang. Compiles with clang --target=wasm32-unknown-linux-musl
against the gexcc sysroot (musl with gex's wasm32 arch, libgex, compiler-rt).
A link writes a program: a position-independent wasm module importing gex's
memory and function table, in the ELF32 container gexc runs
(toolchain/gexcc/wasm-elf.py). The container also carries a host launcher
(hoststub.c): on an x86 Linux build machine the program runs itself under
gexc, so configure checks and test suites run it like a native binary.

Libraries are static. `-shared` writes an archive (with a `gexcc.deps` member
naming the libraries it was linked with), so a project that insists on
building libfoo.so still links: -lfoo then takes the archive, and its
dependencies follow it into the program.

Layout (toolchain/gexcc/install.sh PREFIX):
  PREFIX/bin/gexcc, gexc++, wasm32-unknown-linux-musl-{cc,gcc,c++,g++,ar,...}
  PREFIX/lib/gexcc/     flags.sh, wasm-elf.py, forkreach.py, hoststub.bin,
                        runner (the gexc path baked into containers)
  PREFIX/sysroot/       include/, lib/ (musl, libgex, builtins), binaryen/,
                        usr/ (where cross-built libraries install)

Environment: GEXCC_SYSROOT overrides the sysroot; GEXCC_RUNNER the gexc a
container runs under (also read by the container itself at run time);
GEXCC_BAKE_RUNNER a runner path to link into containers (unset or empty:
none, and a container finds gexcc-exec or gexc on PATH);
GEXCC_KEEP_WASM=1 keeps OUT.wasm beside a linked program; GEXCC_VERBOSE=1
prints every command; GEXCC_NOFORK=1 is -fgex-no-fork (a link whose fork
returns ENOSYS, with no asyncify: rt/nofork.c). -fgex-guest-i386: a program
that runs i386 code of its own (a JIT's: <gex/i386.h>, rt/i386.c)."""
import atexit, os, re, shutil, subprocess, sys, tempfile

TRIPLE = 'wasm32-unknown-linux-musl'
me = os.path.realpath(__file__)
# The compiler, linker and binaryen are build-machine programs: a build that
# points LD_LIBRARY_PATH (or LD_PRELOAD) at the target libraries it just made
# (ncurses' tests, libtool's wrappers) must not hand them to the host's
# loader, which stops at a wasm file ("invalid ELF header")
for v in ('LD_LIBRARY_PATH', 'LD_PRELOAD'):
    os.environ.pop(v, None)
PREFIX = os.path.dirname(os.path.dirname(me))
LIBDIR = os.path.join(PREFIX, 'lib', 'gexcc')
SYSROOT = os.environ.get('GEXCC_SYSROOT') or os.path.join(PREFIX, 'sysroot')
VERBOSE = bool(os.environ.get('GEXCC_VERBOSE'))
name = os.path.basename(sys.argv[0])
CXX = name.endswith(('++', 'cxx')) or name.endswith('-c++')


def die(msg, code=1):
    sys.stderr.write('gexcc: %s\n' % msg)
    sys.exit(code)


def run(cmd):
    if VERBOSE:
        sys.stderr.write('+ %s\n' % ' '.join(cmd))
    return subprocess.call(cmd)


if not os.path.isdir(LIBDIR):
    die('no %s: run toolchain/gexcc/install.sh PREFIX and use PREFIX/bin/gexcc' % LIBDIR)


def read_flags():
    flags = {}
    for line in open(os.path.join(LIBDIR, 'flags.sh')):
        if '=' in line and not line.startswith('#'):
            k, v = line.strip().split('=', 1)
            v = v.strip('"')
            for kk, vv in flags.items():
                v = v.replace('$' + kk, vv)
            flags[k] = v
    return flags


FLAGS = read_flags()
# Programs and their libraries lower setjmp onto the legacy exception
# instructions: binaryen's asyncify (fork) can instrument try/catch but not
# try_table. The link translates them to the standard ones (finish()).
BASE = [a.replace('-wasm-use-legacy-eh=false', '-wasm-use-legacy-eh=true') for a in FLAGS['WASM_CFLAGS'].split()]
# C++: exceptions and RTTI are on unless asked off (libc++abi over wasm EH).
# C++ exceptions on wasm EH: clang turns on the backend's lowering
# (-wasm-enable-eh) only for emscripten; without it every catch is dropped.
# C gets it too, for -fexceptions cleanups.
BASE += ['-mllvm', '-wasm-enable-eh']
# Default visibility, as on ELF (clang's wasm default is hidden): a library
# built shared exports what it would on Linux, and a static build is the
# same code. A later -fvisibility= wins.
BASE += ['-fvisibility=default']
# A call to an undeclared C library function is a warning, as with GCC on
# glibc in effect: glibc's headers declare much more than they must (its
# <stdlib.h> and <unistd.h> bring in <string.h>'s functions), so programs
# that call strcmp after <stdlib.h> alone build there. Clang gives the
# library function its real type, so the call is right on wasm too.
if not CXX:
    BASE += ['-Wno-error=implicit-function-declaration']
# size_t is unsigned long on wasm32 and unsigned int on every other 32-bit
# Linux target, so code that passes a size_t * where it means a uint32_t *
# (kmod's __builtin_uadd_overflow) is right there and only mismatched here:
# a warning, as same-size pointers were before GCC 14 and clang 16.
if not CXX:
    BASE += ['-Wno-error=incompatible-pointer-types']
# `register` in C++17: GCC warns (it is still in glibc-era sources, libGLU),
# clang's default is an error.
if CXX:
    BASE += ['-Wno-error=register']
# A narrowing conversion of a non-constant in a braced initializer: GCC
# warns, clang's default is an error, so code Debian builds for its 32-bit
# ports (apt's fileutl.cc: a 64-bit offset into a size_t) stops here.
# (Clang's one flag covers a constant too, which GCC rejects.)
if CXX:
    BASE += ['-Wno-error=c++11-narrowing']
# An unused `static inline` function: GCC says nothing, clang warns, and a
# -Werror build (keyutils) stops. Still a warning here.
BASE += ['-Wno-error=unused-function']
if CXX:
    BASE = [a for a in BASE if a != '-fno-exceptions'] + ['-fwasm-exceptions']
# Where cross-built libraries install (--prefix=/usr DESTDIR=SYSROOT); the
# libc's include/ is clang's own sysroot default. Debian's packages put
# per-architecture headers (ffi.h, opensslconf.h) in usr/include/TRIPLET,
# which its GCC searches before usr/include.
INCS = []
for d in ('include/gexcc', 'usr/local/include', 'usr/include/wasm32-linux-musl', 'usr/include'):
    if os.path.isdir(os.path.join(SYSROOT, d)):
        INCS += ['-isystem', os.path.join(SYSROOT, d)]
# libc++'s headers come before the C library's (its <math.h> wraps musl's),
# unless asked not to (libc++'s own build, with its headers)
if CXX and os.path.isdir(os.path.join(SYSROOT, 'include', 'c++', 'v1')) and \
        not any(a in ('-nostdinc++', '-nostdinc') for a in sys.argv[1:]):
    INCS = ['-isystem', os.path.join(SYSROOT, 'include', 'c++', 'v1')] + INCS
# The sysroot's headers by their installed names (/usr/include/...): their
# assert()s and __FILE__s name no path of the build machine's
BASE += ['-ffile-prefix-map=' + os.path.realpath(SYSROOT) + '=']
if os.path.realpath(SYSROOT) != SYSROOT:
    BASE += ['-ffile-prefix-map=' + SYSROOT + '=']
CLANG = ['clang++' if CXX else 'clang'] + BASE + ['--sysroot=' + SYSROOT]
# Loop safepoints (poll/GexPoll.cpp): signals reach code that never makes a
# system call. GEXCC_POLL=0 or -fno-gex-poll leaves them out.
POLL = os.environ.get('GEXCC_POLL', '1') != '0' and '-fno-gex-poll' not in sys.argv[1:]
if POLL and os.path.exists(os.path.join(LIBDIR, 'GexPoll.so')):
    CLANG += ['-fpass-plugin=' + os.path.join(LIBDIR, 'GexPoll.so')]
CLANG_TAIL = INCS
# and after the caller's flags too: Debian's build flags turn the warning
# back into an error (-Werror=implicit-function-declaration, which GCC on
# glibc passes for the same reason as above)
if not CXX:
    CLANG_TAIL = CLANG_TAIL + ['-Wno-error=implicit-function-declaration']
# GCC's warning options clang does not have (-Werror=clobbered, mbedtls):
# GCC knows them, so a build that passes them with -Werror expects no error
CLANG_TAIL = CLANG_TAIL + ['-Wno-unknown-warning-option']
# The C library's predefined macros (__STDC_ISO_10646__: wchar_t is UCS-4),
# which GCC on Linux includes before every translation unit and clang's
# wasm driver does not; libedit refuses to build without them
PREDEF = os.path.join(SYSROOT, 'include', 'stdc-predef.h')
if os.path.exists(PREDEF) and not any(a in ('-nostdinc', '-ffreestanding', '-undef') for a in sys.argv[1:]):
    CLANG_TAIL = CLANG_TAIL + ['-include', PREDEF]


def expand_rsp(args):
    out = []
    for a in args:
        if a.startswith('@') and os.path.isfile(a[1:]):
            import shlex
            out += expand_rsp(shlex.split(open(a[1:]).read()))
        else:
            out.append(a)
    return out


# Function pointer cast emulation (finish below): -fgex-fpcast-emu or
# GEXCC_FPCAST=1, at link time.
FPCAST = os.environ.get('GEXCC_FPCAST', '0') != '0' or '-fgex-fpcast-emu' in sys.argv[1:]
# A link that never forks (rt/nofork.c): -fgex-no-fork or GEXCC_NOFORK=1, at
# link time. Off by default: fork there returns ENOSYS, and no asyncify.
NOFORK = os.environ.get('GEXCC_NOFORK', '0') != '0' or '-fgex-no-fork' in sys.argv[1:]
# A program that runs i386 code of its own (rt/i386.c): -fgex-guest-i386, at
# link time. gex translates i386 in its process (the container's header
# flags, wasm-elf.py --guest-i386 --linux-space).
GUEST_I386 = '-fgex-guest-i386' in sys.argv[1:]
args = [a for a in expand_rsp(sys.argv[1:])
        if a not in ('-fno-gex-poll', '-fgex-poll', '-fgex-fpcast-emu', '-fgex-no-fork', '-fgex-guest-i386')]


def in_sysroot(path):
    """A target library's directory as a build machine with it installed
    would name it (tclConfig.sh's -I/usr/include/tcl8.6): the sysroot's when
    the build machine has none there."""
    if path.startswith('/usr/') and not os.path.exists(path) and os.path.exists(SYSROOT + path):
        return SYSROOT + path
    return path


# The target's own system header directories, as a build machine names them
# (cyrus-sasl's configure adds -I/usr/include for each database it finds).
# They are searched already, from the sysroot; GCC ignores a -I naming a
# system directory, and here it would name the build machine's headers.
SYSTEM_INCS = {'/usr/include', '/usr/local/include', '/usr/include/wasm32-linux-musl'}


def system_inc(opt, path):
    return opt != '-L' and os.path.normpath(path) in SYSTEM_INCS


def sysroot_dirs(argv):
    out, k = [], 0
    while k < len(argv):
        a = argv[k]
        if a in ('-I', '-isystem', '-idirafter', '-L') and k + 1 < len(argv):
            if not system_inc(a, argv[k + 1]):
                out += [a, in_sysroot(argv[k + 1])]
            k += 2; continue
        drop = False
        for opt in ('-isystem', '-idirafter', '-I', '-L'):
            if a.startswith(opt + '/'):
                drop = system_inc(opt, a[len(opt):])
                a = opt + in_sysroot(a[len(opt):]); break
        if not drop:
            out.append(a)
        k += 1
    return out


args = sysroot_dirs(args)


def gcc_only(argv):
    """What Debian's build flags hand GCC that means nothing here: its spec
    files (-specs=, dpkg's PIE ones), link-time optimisation (-flto=auto
    -ffat-lto-objects: wasm-ld would get LLVM bitcode where gexcc's link
    reads wasm objects; the code is optimised per object as before), and
    GCC's `-z KEYWORD`, which is the linker's -z (-Wl,-z,KEYWORD)."""
    out, k = [], 0
    while k < len(argv):
        a = argv[k]
        if a.startswith('-specs=') or a.startswith('-flto') or a in ('-fno-lto', '-ffat-lto-objects',
                                                                      '-fno-fat-lto-objects'):
            k += 1; continue
        if a == '-specs' and k + 1 < len(argv):
            k += 2; continue
        if a == '-z' and k + 1 < len(argv):
            out.append('-Wl,-z,' + argv[k + 1]); k += 2; continue
        out.append(a); k += 1
    return out


args = gcc_only(args)
# -pthread defines _REENTRANT, as GCC's and clang's Linux drivers do (not
# clang's wasm one); configure scripts check it (unbound's AX_PTHREAD)
if '-pthread' in args or '-pthreads' in args:
    BASE += ['-D_REENTRANT']
    CLANG += ['-D_REENTRANT']

# --- queries -------------------------------------------------------------
if args == ['--print-sysroot'] or args == ['-print-sysroot']:
    print(SYSROOT); sys.exit(0)
if args == ['--print-prefix']:
    print(PREFIX); sys.exit(0)
if args == ['-dumpmachine']:
    print(TRIPLE); sys.exit(0)
# Debian's name for the target: its packages put libraries in
# usr/lib/wasm32-linux-musl, which the searches below include.
MULTIARCH = 'wasm32-linux-musl'
if args in (['-print-multiarch'], ['--print-multiarch']):
    print(MULTIARCH); sys.exit(0)
LIBDIRS = [SYSROOT + '/lib', SYSROOT + '/usr/lib', SYSROOT + '/usr/lib/' + MULTIARCH, SYSROOT + '/lib/' + MULTIARCH]
for a in args:
    if a.startswith('-print-file-name='):
        f = a.split('=', 1)[1]
        for d in LIBDIRS:
            if os.path.exists(os.path.join(d, f)):
                print(os.path.join(d, f)); sys.exit(0)
        print(f); sys.exit(0)
    if a == '-print-libgcc-file-name':
        print(SYSROOT + '/lib/libclang_rt.builtins-wasm32.a'); sys.exit(0)
    # GCC's spelling too, and with input files (meson asks with a test
    # file and -c): the answer, and nothing compiled, as GCC does. Meson takes
    # a library directory named here as a system one, so a library found in
    # the multiarch directory gets no run path.
    if a in ('-print-search-dirs', '--print-search-dirs'):
        print('programs: =%s\nlibraries: =%s' % (os.path.dirname(me), ':'.join(LIBDIRS))); sys.exit(0)
    if a.startswith('-print-prog-name='):
        t = a.split('=', 1)[1]
        p = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), TRIPLE + '-' + t)
        print(p if os.path.exists(p) else t); sys.exit(0)
    if a == '-print-multi-os-directory':
        print('.'); sys.exit(0)

# --- as cpp -------------------------------------------------------------------
# Installed as TRIPLE-cpp: the C preprocessor, which reads standard input
# when given no file (xorg-macros' RAWCPP check: `cpp -undef < conftest`)
# and takes `cpp IN OUT`.
if name == 'cpp' or name.endswith('-cpp'):
    CPP_ARG = {'-I', '-D', '-U', '-include', '-imacros', '-isystem', '-idirafter', '-iquote', '-MF', '-MT', '-MQ', '-o',
               '-x', '-std', '-iprefix', '-iwithprefix', '-isysroot', '-target', '--target'}
    files, k = [], 0
    while k < len(args):
        if args[k] in CPP_ARG:
            k += 2; continue
        if args[k] == '-' or not args[k].startswith('-'):
            files.append(k)
        k += 1
    cmd = list(args)
    if len(files) == 2:  # cpp IN OUT
        out_at = files[1]
        cmd = cmd[:out_at] + cmd[out_at + 1:] + ['-o', args[out_at]]
    elif not files:
        cmd.append('-')
    if not any(a == '-x' or a.startswith('-x') for a in cmd):
        cmd = ['-x', 'c'] + cmd
    os.execvp(CLANG[0], CLANG + ['-E'] + cmd + CLANG_TAIL)

# --- compile only -----------------------------------------------------------
SRC_EXT = ('.c', '.cc', '.cpp', '.cxx', '.c++', '.C', '.s', '.S', '.i', '.ii')
# `.symver` (ELF symbol versions, in top-level asm) is a directive the wasm
# assembler does not know, and a wasm module has no symbol versions. A
# compile that fails on one is run again on the preprocessed source with
# those asm statements taken out. The default version's name (`.symver
# impl, name@@V`) is what programs link to, and it is often not the C name
# (fuse's fuse_parse_cmdline is fuse_parse_cmdline_312): in C it becomes an
# alias of the C name. Older versions' names (name@V) are left out.
SYMVER_ASM = re.compile(r'\b(?:__asm__|__asm|asm)\s*(?:volatile\s*|__volatile__\s*)?\(\s*'
                        r'"(?:\\t|\s)*\.symver\b(?:[^"\\]|\\.)*"(?:\s*"(?:[^"\\]|\\.)*")*\s*\)\s*;?')
# GNU ld's link-time warnings (alsa-lib's and glibc's link_warning): an
# asm statement that declares the .gnu.warning.SYMBOL section and data put
# in it, in ELF assembler syntax. Taken out on the same retry: there is no
# such warning on wasm, and nothing else is lost.
ASM_STMT = re.compile(r'\b(?:__asm__|__asm|asm)\s*(?:volatile\s*|__volatile__\s*)?\(\s*'
                      r'"(?:[^"\\]|\\.)*"(?:\s*"(?:[^"\\]|\\.)*")*\s*\)\s*;?')


def gnu_warning(m):
    """An asm statement whose text (its strings joined) names a
    .gnu.warning section."""
    return '.gnu.warning' in ''.join(re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(0)))


GNUWARN_ATTR = re.compile(r'__attribute__\s*\(\(\s*section\s*\(\s*"\.gnu\.warning(?:[^"\\]|\\.)*"(?:\s*"(?:[^"\\]|\\.)*")*\s*\)\s*\)\)')
DEP_FLAGS = {'-MD', '-MMD', '-MP'}
DEP_ARG = {'-MF', '-MT', '-MQ'}


def compile_cmd(cmd):
    """Run a compile, with the `.symver` retry above. Returns its exit code."""
    r = subprocess.run(cmd, stderr=subprocess.PIPE)
    err = r.stderr
    srcs = [a for a in cmd[1:] if a.endswith(SRC_EXT) and not a.endswith(('.s', '.S')) and os.path.isfile(a)]
    symver = b'.symver' in err and b'unknown directive' in err
    if r.returncode == 0 or not (symver or b'.gnu.warning' in err) or len(srcs) != 1:
        sys.stderr.buffer.write(err)
        return r.returncode
    src = srcs[0]
    tmpd = tempfile.mkdtemp(prefix='gexcc-symver-')
    try:
        ii = os.path.join(tmpd, os.path.basename(src) + ('.ii' if CXX or src.endswith(('.cc', '.cpp', '.cxx', '.c++', '.C', '.ii')) else '.i'))
        pre, skip = [], False
        for a in cmd:
            if skip:
                skip = False; continue
            if a == '-o':
                skip = True; continue
            if a in ('-c', '-S') or (a.startswith('-o') and len(a) > 2):
                continue
            pre.append(a)
        obj = next((cmd[k + 1] for k, a in enumerate(cmd[:-1]) if a == '-o'), None)
        if obj and any(a in DEP_FLAGS for a in cmd) and not any(a.startswith(('-MT', '-MQ')) for a in cmd):
            pre += ['-MT', obj]
        if run(pre + ['-E', '-o', ii]):
            sys.stderr.buffer.write(err)
            return r.returncode
        text = open(ii, encoding='utf-8', errors='surrogateescape').read()
        found = SYMVER_ASM.findall(text)
        aliases = {}
        if not ii.endswith('.ii'):
            for f in found:
                d = ''.join(re.findall(r'"((?:[^"\\]|\\.)*)"', f)).replace('\\t', ' ')
                m = re.search(r'\.symver\s+([A-Za-z_][\w.$]*)\s*,\s*([A-Za-z_][\w.$]*)@@', d)
                if m and m.group(1) != m.group(2):
                    aliases[m.group(2)] = m.group(1)
        body = SYMVER_ASM.sub('', text)
        warns = sum(1 for m in ASM_STMT.finditer(body) if gnu_warning(m))
        body = GNUWARN_ATTR.sub('', ASM_STMT.sub(lambda m: '' if gnu_warning(m) else m.group(0), body))
        if warns:
            sys.stderr.write('gexcc: %s: %d GNU ld link warning(s) left out\n' % (src, warns))
        alias = ''.join('extern __typeof__(%s) %s __attribute__((alias("%s")));\n' % (c, a, c)
                        for a, c in sorted(aliases.items()))
        open(ii, 'w', encoding='utf-8', errors='surrogateescape').write(body + alias)
        if found:
            sys.stderr.write('gexcc: %s: %d .symver directive(s) left out (wasm has no symbol versions)%s\n'
                             % (src, len(found), ', %d default name(s) made aliases' % len(aliases) if aliases else ''))
        out, skip = [], False
        for a in cmd:
            if skip:
                skip = False; continue
            if a in DEP_FLAGS:
                continue
            if a in DEP_ARG:
                skip = True; continue
            if a.startswith(('-MF', '-MT', '-MQ')) and len(a) > 3:
                continue
            out.append(ii if a == src else a)
        out += ['-Wno-unused-command-line-argument']
        if aliases:
            r2 = subprocess.run(out, stderr=subprocess.PIPE)
            if r2.returncode == 0:
                sys.stderr.buffer.write(r2.stderr)
                return 0
            # an alias whose name the source declared with another type:
            # the names are left out, as the versions are
            open(ii, 'w', encoding='utf-8', errors='surrogateescape').write(body)
            sys.stderr.write('gexcc: %s: the default names could not be aliases, left out\n' % src)
        return run(out)
    finally:
        shutil.rmtree(tmpd, True)


NOLINK = ('-c', '-S', '-E', '-M', '-MM', '-fsyntax-only', '--version', '-v', '-###', '--help')
# -v on a link (CMake's compiler ABI check: `-v -Wl,-v` with the object) is
# verbose, not a query: the version on stderr, as gcc prints it, then the
# link itself
if '-v' in args and not any(a in NOLINK and a != '-v' for a in args) and \
        any(not a.startswith('-') for a in args):
    subprocess.run([CLANG[0], '--target=' + TRIPLE, '--version'], stdout=sys.stderr)
    args = [a for a in args if a != '-v']
    # and the link line, as GCC prints collect2's: libtool reads the
    # libraries after the object from it (postdeps) and names them itself
    # when it links a C++ library with -nostdlib
    if not any(a in ('-nostdlib', '-nodefaultlibs') for a in args):
        rt = ['-lc++', '-lc++abi', '-lunwind'] if CXX else []
        named = [a for k, a in enumerate(args) if (not a.startswith('-') or a.startswith('-l'))
                 and (k == 0 or args[k - 1] != '-o')]
        sys.stderr.write(' wasm-ld -L%s/lib %s\n' % (SYSROOT, ' '.join(named + rt + ['-lc'])))
if not args or any(a in NOLINK or a.startswith(('-print-', '-dump')) for a in args):
    if args == ['-v'] or args == ['--version'] or not args:
        os.execvp(CLANG[0], [CLANG[0], '--target=' + TRIPLE] + args)
    if '-c' in args and '-E' not in args:
        sys.exit(compile_cmd(CLANG + args + CLANG_TAIL))
    os.execvp(CLANG[0], CLANG + args + CLANG_TAIL)

# --- link -----------------------------------------------------------------
LIBC_NAMES = {'c', 'm', 'pthread', 'dl', 'rt', 'util', 'crypt', 'xnet', 'resolv', 'gcc', 'gcc_s', 'gcc_eh',
              'atomic', 'ssp', 'ssp_nonshared', 'unwind'}
# Linker options with no meaning for a static wasm module, dropped quietly.
# The strip options too (-Wl,-s, --strip-all, --strip-debug: GCC's -s,
# Cargo's strip): a module's names are what gex binds and runs it by.
LD_DROP = re.compile(r'^(-rpath|-rpath-link|--rpath|-soname|-h|--?version-script|-z|--as-needed|--no-as-needed|'
                     r'--no-undefined|-O\d|--hash-style|--build-id|--enable-new-dtags|--disable-new-dtags|'
                     r'-Bsymbolic|-Bsymbolic-functions|--start-group|--end-group|--sort-common|--warn-common|'
                     r'--sort-section|--dynamic-list|-E|--export-dynamic|--no-copy-dt-needed-entries|'
                     r'--copy-dt-needed-entries|-Bdynamic|-Bstatic|--eh-frame-hdr|--icf|-x|-X|--discard-all|'
