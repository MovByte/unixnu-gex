    # as wide as the widest function in a table (binaryen names a call's
    # need, but builds a narrower thunk for a wider function it holds)
    widest = widest_table_params(wasm)
    if widest > 16:
        cmd[-2:-2] = ['--pass-arg=max-func-params@%d' % widest]
    p = subprocess.run(cmd, capture_output=True, text=True)
    # (binaryen names one function's need at a time: raise until it passes)
    for _ in range(64):
        m = re.findall(r'max-func-params needs to be at least (\d+)', p.stderr + p.stdout)
        if not (p.returncode and m):
            break
        p = subprocess.run(cmd[:-2] + ['--pass-arg=max-func-params@' + str(max(max(map(int, m)) + 4, widest)), '-o', wasm],
                           capture_output=True, text=True)
    if p.returncode:
        sys.stderr.write(p.stderr)
        die('wasm-opt --fpcast-emu failed')
    if thunks and run([DYLINK, 'fpcast-post', wasm, wasm]):
        die('gex-dylink fpcast-post failed')
    r = run([sys.executable, os.path.join(LIBDIR, 'elemfix.py'), wasm, '__gex_start', '__gex_thread_start'])
    if r:
        die('elemfix.py failed after --fpcast-emu')
passes = []
if SHARED:
    pass
elif NOFORK:
    no_fork_point(wasm)
elif ('gex', 'fork_point') in imports(wasm):
    passes += ['--asyncify', '--pass-arg=asyncify-imports@gex.fork_point']
    dis = os.path.join(os.path.dirname(opt), 'wasm-dis')
    reach = subprocess.run([sys.executable, os.path.join(LIBDIR, 'forkreach.py'), dis, wasm, 'gex.fork_point'] + FORK_ROOTS,
                           capture_output=True, text=True)
    if reach.returncode == 0:
        lst = os.path.join(tmp, 'onlylist')
        open(lst, 'w').write(reach.stdout.strip().replace(',', '\n') + '\n')
        passes += ['--pass-arg=asyncify-onlylist@@' + lst]
    else:
        passes += ['--pass-arg=asyncify-removelist@' + ','.join(FORK_ROOTS)]
    passes += ['-O2']
if not SHARED:
    passes += ['--translate-to-exnref']
# names kept (-g): gex binds the entries by name. (DWARF dropped: binaryen
# cannot rewrite clang's version 5.)
r = run([opt, wasm, '-g', '--strip-dwarf'] + feats + passes + ['-o', wasm])
if r:
    die('wasm-opt failed')
cont = ['--host-stub', os.path.join(LIBDIR, 'hoststub.bin')]
# No path of this machine's goes into a container unless GEXCC_BAKE_RUNNER
# names one: what is built may run anywhere (a package in an image), and
# on the build machine a container finds its runner through GEXCC_RUNNER or
# gexcc-exec (else gexc) on PATH (hoststub.c)
if os.environ.get('GEXCC_BAKE_RUNNER'):
    cont += ['--runner', os.environ['GEXCC_BAKE_RUNNER']]
if GUEST_I386:
    cont += ['--guest-i386', '--linux-space']
r = run([sys.executable, os.path.join(LIBDIR, 'wasm-elf.py'), wasm, out] + cont)
if r:
    sys.exit(r)
if os.environ.get('GEXCC_KEEP_WASM'):
    shutil.copy(wasm, out + '.wasm')
